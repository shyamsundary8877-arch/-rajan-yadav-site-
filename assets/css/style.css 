:root{
  --brand: #2563EB; /* change to your hex color */
  --bg: #0b1220;
  --card: #0f1a30;
  --text: #eaf0ff;
  --muted: #aab6d6;
  --border: rgba(255,255,255,.10);
}

*{ box-sizing:border-box; }
body{
  margin:0;
  font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  background: radial-gradient(1000px 500px at 20% 0%, rgba(37,99,235,.25), transparent),
              radial-gradient(1000px 500px at 90% 10%, rgba(99,102,241,.20), transparent),
              var(--bg);
  color:var(--text);
}
.container{ width:min(1100px, 92%); margin:0 auto; }

.nav{ position:sticky; top:0; backdrop-filter: blur(10px); border-bottom:1px solid var(--border); background: rgba(11,18,32,.65); }
.nav-inner{ display:flex; align-items:center; justify-content:space-between; padding:14px 0; gap:16px; }
.brand{ color:var(--text); text-decoration:none; font-weight:800; letter-spacing:.2px; }
.links{ display:flex; flex-wrap:wrap; gap:12px; }
.links a{ color:var(--muted); text-decoration:none; padding:8px 10px; border-radius:10px; }
.links a.active, .links a:hover{ color:var(--text); background: rgba(255,255,255,.06); }

.hero{ display:grid; grid-template-columns: 1.2fr .8fr; gap:20px; padding:34px 0 18px; }
@media (max-width: 860px){ .hero{ grid-template-columns:1fr; } }

h1{ font-size: clamp(28px, 3.4vw, 44px); margin:0 0 10px; line-height:1.1; }
h2{ margin:0; }
.accent{ color: var(--brand); }
.muted{ color:var(--muted); }

.section{ padding:22px 0 36px; }
.section-head{ display:flex; align-items:center; justify-content:space-between; gap:12px; margin:10px 0 14px; }

.card, .hero-card{
  background: linear-gradient(180deg, rgba(255,255,255,.06), rgba(255,255,255,.03));
  border:1px solid var(--border);
  border-radius:16px;
  padding:16px;
}
.grid{ display:grid; grid-template-columns: repeat(3, 1fr); gap:14px; }
@media (max-width: 950px){ .grid{ grid-template-columns: repeat(2, 1fr);} }
@media (max-width: 560px){ .grid{ grid-template-columns: 1fr;} }

.project{
  padding:16px;
  border-radius:16px;
  border:1px solid var(--border);
  background: rgba(255,255,255,.04);
}
.badge{
  display:inline-flex;
  gap:8px;
  align-items:center;
  border:1px solid var(--border);
  padding:6px 10px;
  border-radius:999px;
  color:var(--muted);
  font-size:12px;
}
.tech{ display:flex; flex-wrap:wrap; gap:8px; margin-top:10px; }

.btn{
  display:inline-block;
  background: var(--brand);
  color:white;
  text-decoration:none;
  border:none;
  padding:10px 14px;
  border-radius:12px;
  font-weight:700;
  cursor:pointer;
}
.btn-ghost{
  background: transparent;
  border:1px solid var(--border);
  color:var(--text);
}
.cta{ display:flex; gap:10px; flex-wrap:wrap; margin-top:14px; }

.input{
  width:100%;
  border-radius:12px;
  border:1px solid var(--border);
  background: rgba(255,255,255,.03);
  padding:10px 12px;
  color:var(--text);
  outline:none;
}
.toolbar{ display:grid; grid-template-columns: 1fr 220px; gap:12px; margin:14px 0; }
@media (max-width: 650px){ .toolbar{ grid-template-columns:1fr; } }

.label{ display:block; margin:10px 0 6px; color:var(--muted); font-size:14px; }
.link{ color: var(--text); text-decoration:none; opacity:.9; }
.link:hover{ opacity:1; text-decoration:underline; }

.footer{ border-top:1px solid var(--border); margin-top:30px; }
.footer-inner{ display:flex; justify-content:space-between; gap:12px; padding:18px 0; flex-wrap:wrap; }

.checklist{ margin:10px 0 0; padding-left:18px; color:var(--muted); }
.imgph{
  height: 180px;
  border-radius:16px;
  border:1px dashed rgba(255,255,255,.2);
  display:grid;
  place-items:center;
  color:rgba(255,255,255,.6);
    }
